# Copy this file to `.env` and fill in the real values:
#
#   cp .env.example .env && nano .env
#
# .env is gitignored (see .gitignore) — NEVER commit it or paste it anywhere.
# These variables are injected into the MT5 Docker container by
# docker-compose.yml (env_file). Note: the image only uses them for its
# FIRST-RUN auto-login; once the Wine prefix exists, the login is stored in
# the prefix and must be managed inside MT5 itself (via the noVNC UI).

# MT5 account number
MT5_LOGIN=

# MT5 account password (rotate it if it was ever exposed)
MT5_PASSWORD=

# Broker server name, exactly as shown in MT5 (spaces included)
MT5_SERVER=XMGlobal-MT5 17

# Password for the noVNC web UI (http://<server-ip>:8080)
VNC_PASSWORD=
