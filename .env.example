# Copy this file to `.env` and fill in the real values:
#
#   cp .env.example .env && nano .env
#
# .env is gitignored (see .gitignore) — NEVER commit it or paste it anywhere.
# These variables are injected into the MT5 Docker container(s) by
# docker-compose.yml (env_file). Note: the image only uses them for its
# FIRST-RUN auto-login; once the Wine prefix exists, the login is stored in
# the prefix and must be managed inside MT5 itself (via the noVNC UI).

# ── Hybrid mode (2026-10-04) ───────────────────────────────────────────
# shared   = one XM login, one container (mt5-gold :18812), one equity pool — today
# isolated = two logins, two containers (mt5-gold :18812 + mt5-btc :18813), two pools
# The bots read ACCOUNT_MODE from env; default is shared.
ACCOUNT_MODE=shared

# ── Shared mode (what you run today) ──────────────────────────────────
# MT5 account number
MT5_LOGIN=

# MT5 account password (rotate it if it was ever exposed)
MT5_PASSWORD=

# Broker server name, exactly as shown in MT5 (spaces included)
MT5_SERVER=XMGlobal-MT5 17

# Password for the noVNC web UI (http://<server-ip>:8080 gold, :8081 btc when isolated)
VNC_PASSWORD=

# Bridge ports (rarely need to change)
MT5_HOST=localhost
MT5_GOLD_PORT=18812
MT5_BTC_PORT=18813

# ── Isolated mode (only needed if you split to two XM accounts) ───────
# When ACCOUNT_MODE=isolated, GOLD reads MT5_GOLD_* (fallback MT5_*), BTC reads MT5_BTC_*
# Leave blank while shared. Fill them when you want per-symbol accounts.
#MT5_GOLD_LOGIN=
#MT5_GOLD_PASSWORD=
#MT5_GOLD_SERVER=XMGlobal-MT5 17
#MT5_GOLD_VNC_PASSWORD=
#MT5_BTC_LOGIN=
#MT5_BTC_PASSWORD=
#MT5_BTC_SERVER=XMGlobal-MT5 17
#MT5_BTC_VNC_PASSWORD=

# ── Portfolio gates (shared mode only) ────────────────────────────────
# Combined daily limits when one equity pool is shared. Per-bot limits
# (MAX_DAILY_LOSS 30/8, MAX_TRADES 15) stay as defense-in-depth.
# Defaults: 38 / 25 (gold 30+ btc 8, trades capped at 25). Override here if re-derived.
#PORTFOLIO_MAX_DAILY_LOSS=38
#PORTFOLIO_MAX_TRADES_PER_DAY=25
