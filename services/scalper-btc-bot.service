[Unit]
Description=Bitcoin Scalper (BTCUSD) Live Trading Bot - FORWARD_TEST/paper
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple
User=root
# WorkingDirectory + the script path both put btc/ first on sys.path, so the
# engine resolves btc/config.py. btc/run.py also pre-registers it in sys.modules
# (see btc/_instance.py) so path order can never mix the two instances.
WorkingDirectory=/root/scalper/btc
Environment=PATH=/root/scalper/mt5env/bin:/usr/local/bin:/usr/bin:/bin
# Hybrid 2026-10-04: isolated BTC reads MT5_BTC_PORT via env; shared keeps 18812.
EnvironmentFile=-/root/scalper/.env
# Same shared MT5 container/bridge as the gold bot in shared mode (localhost:18812),
# second container :18813 in isolated mode.
ExecStartPre=/root/scalper/mt5env/bin/python /root/scalper/wait_for_mt5.py --timeout 180
ExecStart=/root/scalper/mt5env/bin/python -u /root/scalper/btc/run.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
