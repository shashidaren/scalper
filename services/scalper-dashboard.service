[Unit]
Description=Gold Scalper Web Dashboard
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/scalper
Environment=PATH=/root/scalper/mt5env/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/root/scalper/mt5env/bin/uvicorn dashboard:app --host 0.0.0.0 --port 8088
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
